# 造数凭据。cp .env.example .env 后填写。
# 本目录的 .env 已被仓库 .gitignore（第 15 行 `.env`）覆盖，不会被提交。
#
# 为什么走文件而不是命令行：--erp-key 会出现在 shell 历史和 ps 输出里，
# 一台多人用的机器上这就是泄漏。

# ---- ERPNext ----
ERP_URL=http://localhost:8090
# 用户列表 → Administrator → 设置 → API 访问 → 生成密钥（secret 只显示一次）
ERP_API_KEY=
ERP_API_SECRET=
# 留空则投递器自动取默认值；取不到会报错并提示
ERP_COMPANY=
ERP_WAREHOUSE=

# ---- Odoo ----
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_o2c
ODOO_USER=admin
ODOO_PASSWORD=
