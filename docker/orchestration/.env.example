# 复制为 .env 后按本机实际情况改。所有值都有默认，缺省即用本机现有服务。

# ---- 镜像 ----
# ⚠ 本机实测（2026-08）：Docker Hub 直连可用但极慢——alpine:3.20（约 4MB）耗时 6 分 03 秒。
# 按此速率 airflow(~1.5GB)/seatunnel(~1GB)/doris(~3GB) 直连基本拉不下来，**必须配镜像源**。
# 本机已有镜像里存在 docker.m.daocloud.io/library/postgres:16，说明该镜像源可用。
# 给这几个变量加镜像源前缀，例如：
#   IMG_AIRFLOW=docker.m.daocloud.io/apache/airflow:2.10.5
# 或在 Docker Desktop → Settings → Docker Engine 配 registry-mirrors（对所有 pull 生效，更省事）。
IMG_AIRFLOW=apache/airflow:2.10.5
IMG_SEATUNNEL=apache/seatunnel:2.3.11
IMG_POSTGRES=postgres:16-alpine
IMG_DORIS=apache/doris:doris-all-in-one-2.1.0

# 与本机 DataHub 版本对齐；1.6.0 同时兼容 Airflow 2.5+/3.x
DATAHUB_PLUGIN_VERSION=1.6.0

# ---- 已在本机运行的服务 ----
# 容器名来自 `docker ps`；GMS 走容器网络内部地址，不用 localhost。
DATAHUB_GMS_URL=http://datahub-datahub-gms-quickstart-1:8080
DATAHUB_NETWORK=datahub_network
ERPNEXT_NETWORK=erpnext_frappe_network

# ontoMeta 后端（宿主机上跑 uvicorn 时用 host.docker.internal）
ONTOMETA_API=http://host.docker.internal:8000
ONTOMETA_ADMIN_TOKEN=dev-admin-token-change-me

# ---- 目录 ----
# ontoMeta 生成的 DAG / SeaTunnel 作业配置落盘位置（方案 A：产物即制品）
ORCH_DAGS_DIR=./dags
ORCH_JOBS_DIR=./seatunnel/jobs

# ---- 源库（ERPNext MariaDB）----
# 容器内主机名走 erpnext_frappe_network；库名见本体的 source_ref URN，形如 _3214abce8e7be3d7
ERP_DB_HOST=db
ERP_DB_PORT=3306
ERP_DB_NAME=
ERP_DB_USER=
ERP_DB_PASSWORD=
