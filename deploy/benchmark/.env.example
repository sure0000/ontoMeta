# ontoMeta 验证环境 —— docker 宿主机侧配置
# 用法：cp .env.example .env 后按注释改；所有 compose 文件共用本文件。

# ============ 镜像源（第一道坎，务必先配）============
# Docker Hub 直连实测极慢（4MB 的 alpine 拉了 6 分钟），大镜像根本拉不下来。
# 配好 /etc/docker/daemon.json 的 registry-mirrors 后重启 docker，再跑 preflight。
IMG_MARIADB=mariadb:10.6
IMG_POSTGRES=postgres:16
IMG_REDIS=redis:6.2-alpine
IMG_ODOO=odoo:17
IMG_AIRFLOW=apache/airflow:2.10.5
IMG_FLINK=flink:1.13.6-scala_2.12-java8

# ============ 宿主机在 tailnet 里的地址 ============
# mac 上的 ontoMeta 靠它连过来。`tailscale ip -4` 取。
BENCH_HOST_IP=100.0.0.0

# ============ 端口（宿主机侧，已避开互相冲突）============
ERP_WEB_PORT=8090          # ERPNext 前端
ERP_DB_PORT=3306           # MariaDB —— DataHub 采集 + Flink 读源
ODOO_WEB_PORT=8069
ODOO_DB_PORT=5432          # Odoo Postgres —— DataHub 采集 + Flink 读源
DATAHUB_GMS_PORT=8080
DATAHUB_WEB_PORT=9002
AIRFLOW_WEB_PORT=8081
FLINK_REST_PORT=8082       # 避开 Airflow 的 8081
DWH_DB_PORT=5433           # 目标数仓 Postgres（物化落库）

# ============ 凭据（验证环境，别复用生产口令）============
ERP_DB_ROOT_PASSWORD=change-me-erp
ERP_ADMIN_PASSWORD=change-me-admin
ODOO_DB_PASSWORD=change-me-odoo
DWH_DB_PASSWORD=change-me-dwh
AIRFLOW_ADMIN_PASSWORD=admin
# 供 DataHub 采集与 Flink 读源的只读账号
RO_USER=datahub_ro
RO_PASSWORD=change-me-ro

# ============ 共享目录（ontoMeta 投递 DAG 的落点）============
# 宿主机上的真实路径；同时通过 NFS/SMB 导出给 mac 挂载。
# DAG 内的 SQL 目录是 Path(__file__).parent/"jobs" 运行期解析的，
# 两侧挂载点不同不影响——但两侧必须指向同一份文件。
BENCH_DAGS_DIR=/srv/ontometa/dags

# ============ Flink ============
# SqlRunner jar 在容器内的路径（由 flink.Dockerfile / airflow.Dockerfile COPY 进去）
FLINK_SQL_RUNNER_JAR=/opt/ontometa/sql-runner.jar
FLINK_TM_SLOTS=4
