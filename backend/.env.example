# ⚠ 配置原则（详见 docs/DEVELOPMENT_PRINCIPLES.md · P1）
# 业务/连接/执行配置一律在【设置页】配置并落库，运行期从 DB 读取——**不要**往这里加应用配置。
# DataHub / LLM / Airflow / Flink 执行 / 草稿生成 / Data Agent 等全部在设置页管理。
# 本文件只保留天然无法 Web 化的引导期(bootstrap) 变量。

# === 引导期（bootstrap）===
# 生产设为 false，避免 500 响应泄露异常细节
DEBUG=true

# 管理端鉴权根：未配置时 /api 管理接口返回 503。
# 请求头 X-Admin-Token 或 Authorization: Bearer <token>；前端在设置页「管理鉴权」填入同值。
ONTOMETA_ADMIN_TOKEN=dev-admin-token-change-me
# 可选：主体令牌哈希 pepper；变更后须重新签发全部主体令牌
# API_KEY_HASH_PEPPER=

# 数据库地址（连 DB 的地址不可能存进 DB，故必须在此）。
# 生产 / Docker 建议 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://ontometa:ontometa@localhost:5432/ontometa
DATABASE_URL=sqlite:///./ontometa.db

# CORS（进程启动即需；JSON 数组，一般无需改）
# CORS_ORIGINS=["http://localhost:5180","http://localhost:5173","http://localhost:3000"]
