# === 应用 ===
# 生产请设为 false，避免 500 响应泄露异常细节
DEBUG=true

# === 鉴权（管理端必填）===
# 未配置时 /api 管理接口返回 503
# 请求头：X-Admin-Token 或 Authorization: Bearer <token>
# 前端：设置页「管理鉴权」或 VITE_ONTOMETA_ADMIN_TOKEN
ONTOMETA_ADMIN_TOKEN=dev-admin-token-change-me

# 可选：主体令牌哈希 pepper；变更后须重新签发全部主体令牌
# API_KEY_HASH_PEPPER=

# === 数据库 ===
# 开发用 SQLite；生产 / Docker Compose 建议 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://ontometa:ontometa@localhost:5432/ontometa
DATABASE_URL=sqlite:///./ontometa.db

# === DataHub ===
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
# DATAHUB_TOKEN=
# DataHub 拉取并发上限
# DATAHUB_MAX_CONCURRENCY=5

# === LLM ===
# 未配 api_key 时：本体草稿以证据确定性命名兽底；表达式/代码导入等纯 LLM 能力则显式报错。
# OPENAI_API_KEY=  # 也可在「设置」页面配置 DeepSeek 等服务
# OPENAI_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=300

# === 草稿生成并发 ===
# MAX_CONCURRENT_DRAFT_GENERATIONS=2

# === Cube 语义层（可选外挂）===
# 注：Cube 配置现已改为在【设置页 → Cube 语义层】管理（存入 DB，无需配置文件）。
# 下方环境变量仅在首次启动时作为【初始默认值】播种一次；此后以设置页为权威。
# CUBE_API_URL=http://localhost:4000
# CUBE_API_SECRET=
# CUBE_TIMEOUT_SECONDS=30
# CUBE_PREAGG_REFRESH=1 hour
# CUBE_TENANT_DIMENSION=tenant_id

# === Data Agent 语义能力（DATA_AGENT_V2_PLAN）===
# run_sql / profile_values 最低角色。这两个工具会读真实数据，与手动执行端点同价；
# 降为 editor 可回到改造前行为。
# AGENT_RUN_SQL_MIN_ROLE=publisher
# SQL 语义证明与断言级核验闸门：off / warn / on
# AGENT_SOUNDNESS=on
# 字段取值画像缓存与 TopN
# AGENT_PROFILE_CACHE_SECONDS=900
# AGENT_PROFILE_TOP_N=20
# 语义检索（P1.5）：**留空即关闭**，检索退回纯 ILIKE，功能不受影响，只是同义词
# （客户 / 往来单位 / Customer）召回不到。填入嵌入模型名即启用，走上面配置的
# OpenAI 兼容服务；发布本体时自动重建索引。
# AGENT_EMBEDDING_MODEL=text-embedding-3-small
# 向量截断维度（0=不截断）。截短能让检索快数倍而召回基本无损。
# AGENT_EMBEDDING_DIM=256
# 余弦相似度下限，低于此分不作为召回结果（0=不过滤）
# AGENT_EMBEDDING_MIN_SCORE=0.0

# === CORS（JSON 数组；一般无需改）===
# CORS_ORIGINS=["http://localhost:5180","http://localhost:5173","http://localhost:3000"]
