  "data_context": {
    "data_source_ref": "datasource:warehouse",
    "source_catalog": "erp",
    "source_database": "sales",
    "target_engine": "iceberg",
    "target_database_prefix": "sales",
    "connection_status": "ok",
    "credentials_in_fixture": false
  },
  "expected_dimensional_model": {
    "name": "sales_fulfillment_model",
    "display_name": "销售履约分析模型",
    "business_process": "销售订单履约",
    "facts": [
      {
        "name": "fact_sales_order_line",
        "display_name": "销售订单行事实",
        "fact_type": "transaction",
        "grain": {
          "statement": "每个销售订单行一行",
          "keys": [
            "property:sales_order_line:id"
          ]
        },
        "source_object_ref": "object:sales_order_line",
        "event_time_property_ref": "property:sales_order:ordered_at",
        "measures": [
          {
            "property_ref": "property:sales_order_line:quantity",
            "aggregation": "sum",
            "additivity": "additive"
          },
          {
            "property_ref": "property:sales_order_line:line_amount",
            "aggregation": "sum",
            "additivity": "additive"
          }
        ],
        "dimensions": [
          {
            "dimension_ref": "dim_customer",
            "role": "customer"
          },
          {
            "dimension_ref": "dim_product",
            "role": "product"
          },
          {
            "dimension_ref": "dim_channel",
            "role": "channel"
          },
          {
            "dimension_ref": "dim_order_date",
            "role": "order_date"
          }
        ],
        "degenerate_dimensions": [
          "property:sales_order_line:order_id"
        ]
      }
    ],
    "dimensions": [
      {
        "name": "dim_customer",
        "display_name": "客户维度",
        "source_object_ref": "object:customer",
        "natural_key_property_refs": [
          "property:customer:id"
        ],
        "surrogate_key": {
          "enabled": true,
          "name": "customer_sk"
        },
        "attribute_property_refs": [
          "property:customer:name",
          "property:customer:level"
        ],
        "scd_type": "scd2",
        "conformed_key": "customer"
      },
      {
        "name": "dim_product",
        "display_name": "商品维度",
        "source_object_ref": "object:product",
        "natural_key_property_refs": [
          "property:product:id"
        ],
        "surrogate_key": {
          "enabled": true,
          "name": "product_sk"
        },
        "attribute_property_refs": [
          "property:product:name",
          "property:product:category"
        ],
        "scd_type": "scd1",
        "conformed_key": "product"
      },
      {
        "name": "dim_channel",
        "display_name": "渠道维度",
        "source_object_ref": "object:channel",
        "natural_key_property_refs": [
          "property:channel:id"
        ],
        "surrogate_key": {
          "enabled": true,
          "name": "channel_sk"
        },
        "attribute_property_refs": [
          "property:channel:name"
        ],
        "scd_type": "scd1",
        "conformed_key": "channel"
      },
      {
        "name": "dim_order_date",
        "display_name": "下单日期维度",
        "source_object_ref": null,
        "natural_key_property_refs": [],
        "surrogate_key": {
          "enabled": false,
          "name": "date_key"
        },
        "attribute_property_refs": [],
        "scd_type": "none",
        "conformed_key": "date",
        "role_playing_source": "calendar_date"
      }
    ],
    "bridges": [],
    "required_validation_outcomes": {
      "errors": [],
      "warnings_allowed": [
        "shipment_allocation_required"
      ]
    }
  },
  "expected_logic_bundle": {
    "items": [
      {
        "kind": "metric",
        "name": "sales_amount",
        "display_name": "销售额",
        "target_fact": "fact_sales_order_line",
        "operation": "sum",
        "input_property_ref": "property:sales_order_line:line_amount"
      },
      {
        "kind": "metric",
        "name": "order_count",
        "display_name": "订单量",
        "target_fact": "fact_sales_order_line",
        "operation": "count_distinct",
        "input_property_ref": "property:sales_order_line:order_id"
      },
      {
        "kind": "metric",
        "name": "delay_rate",
        "display_name": "延期率",
        "target_fact": "fact_sales_order_line",
        "operation": "ratio",
        "definition": "延期订单数 / 可判断履约的订单数"
      },
      {
        "kind": "tag",
        "name": "high_delay_risk_customer",
        "display_name": "高延期风险客户",
        "subject_dimension": "dim_customer",
        "definition": "过去 90 天订单数不少于 5 且延期率大于等于 20%",
        "threshold_source": "requirement_confirmation"
      }
    ]
  },
  "expected_delivery_plan": {
    "steps": [
      {
        "id": "materialize_model",
        "kind": "materialize",
        "depends_on": []
      },
      {
        "id": "sync_sources",
        "kind": "sync",
        "depends_on": [
          "materialize_model"
        ]
      },
      {
        "id": "transform_fact_dimensions",
        "kind": "transform",
        "depends_on": [
          "sync_sources"
        ]
      },
      {
        "id": "materialize_logic_bundle",
        "kind": "metric",
        "depends_on": [
          "transform_fact_dimensions"
        ]
      }
