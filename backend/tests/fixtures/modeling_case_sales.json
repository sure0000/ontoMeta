{
  "fixture_version": "1.0.0",
  "name": "sales_fulfillment_modeling_case",
  "display_name": "销售履约对话式建模验收场景",
  "purpose": "P0 场景基线：为 ModelingCase、DimensionalModel、LogicBundle、DeliveryPlan 与端到端验收提供稳定输入和预期结果。所有 ref 均为 fixture 稳定标识，不是生产数据库 ID。",
  "requirement": {
    "user_request": "分析过去 90 天订单履约，按客户、商品和渠道看销售额、订单量、延期率，并给高延期风险客户打标签，最后生成每天刷新的销售履约看板。",
    "business_goal": "识别订单履约风险并定位高延期风险客户",
    "business_processes": [
      "销售订单履约"
    ],
    "subjects": [
      "销售订单",
      "销售订单行",
      "客户",
      "商品",
      "渠道",
      "发货"
    ],
    "time_scope": {
      "type": "rolling",
      "value": 90,
      "unit": "day"
    },
    "grain_expectation": "每个销售订单行一行",
    "requested_metrics": [
      "销售额",
      "订单量",
      "延期率"
    ],
    "requested_tags": [
      "高延期风险客户"
    ],
    "refresh_sla": "0 2 * * *",
    "delivery": [
      "dashboard"
    ],
    "required_clarifications": [
      {
        "key": "fact_grain",
        "question": "销售分析按订单还是订单行作为事实粒度？",
        "confirmed_value": "订单行"
      },
      {
        "key": "delay_definition",
        "question": "延期按承诺发货日还是要求到货日判断？",
        "confirmed_value": "实际发货时间晚于承诺发货时间"
      },
      {
        "key": "risk_threshold",
        "question": "高延期风险客户的阈值是多少？",
        "confirmed_value": "过去 90 天订单数不少于 5 且延期率大于等于 20%"
      }
    ],
    "acceptance_criteria": [
      "销售额、订单量、延期率与 fixture 金标准口径一致",
      "多次发货不会重复累计订单行销售额",
      "任务真实失败时建模工单不得进入 completed",
      "看板中的所有面板均引用已确认模型与口径版本"
    ]
  },
  "ontology": {
