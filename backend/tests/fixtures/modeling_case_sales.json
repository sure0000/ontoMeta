    "schedule_cron": "0 2 * * *",
    "data_app": {
      "kind": "dashboard",
      "name": "销售履约看板",
      "panels": [
        "销售额趋势",
        "订单量趋势",
        "客户延期率",
        "高延期风险客户"
      ]
    }
  },
  "negative_cases": [
    {
      "name": "missing_grain",
      "mutation": "remove expected_dimensional_model.facts[0].grain",
      "expected_code": "grain_missing"
    },
    {
      "name": "unresolved_grain_key",
      "mutation": "replace grain key with property:unknown:id",
      "expected_code": "grain_key_unresolved"
    },
    {
      "name": "fanout_without_allocation",
      "mutation": "join shipment directly to order lines and sum line_amount",
      "expected_code": "fanout_risk"
    },
    {
      "name": "tag_threshold_missing",
      "mutation": "remove risk_threshold confirmation",
      "expected_code": "tag_threshold_unconfirmed"
    },
    {
      "name": "scd2_engine_gap",
      "mutation": "set target_engine to clickhouse while customer scd_type remains scd2",
      "expected_code": "scd_capability_gap"
    }
  ]
}
